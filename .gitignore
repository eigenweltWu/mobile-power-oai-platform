# Python
__pycache__/
*.pyc
.pytest_cache/

# 仓库根目录的旧版/临时 Python 工具（正式后端位于 experiment_platform/backend）
/*.py
/scripts/*.py

# 旧版 monitor.py 的运行时数据与工具（ADB/CIT/GPSTest 大文件，不提交）
data/
.tools/
config.json
/monitor.py
/static/
/start.ps1

# 本地研究资料、过程日志与导出文档；仓库只保留正式项目 README/API 指南
/*.md
!/README.md
/*.pdf
/*.docx

# 实验平台
experiment_platform/data/
experiment_platform/config.local.json
experiment_platform/web/node_modules/
experiment_platform/web/dist/

# 混响室厂商控制程序（76MB 第三方 SDK/DLL，仅本地参考）
measurement system/

# 临时脚本 / 提交信息文件
.tmp_*
COMMIT_MSG*.txt
*.bak.*

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.jks
*.keystore
